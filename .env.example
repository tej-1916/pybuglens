# ==============================================================================
# AI-Powered Bug Detection System - Environment Configuration Template
# Copy this file to .env and configure values as needed.
# NEVER commit .env to Git or expose sensitive API keys.
# ==============================================================================

# Application Settings
APP_NAME="AI-Powered Bug Detection System"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false

# Server Settings
HOST="127.0.0.1"
PORT=8000
CORS_ORIGINS=["*"]

# Database Settings (Local SQLite)
DATABASE_URL="sqlite:///./data/bug_detector.db"

# Security & Guardrails
MAX_CODE_SIZE_BYTES=102400
MAX_CODE_LINES=2000
DEMO_MODE=false
RATE_LIMIT_PER_MINUTE=60

# OpenAI API Settings (Optional)
# Leave empty to run the system entirely offline with local AST static analysis.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TIMEOUT_SECONDS=30.0
